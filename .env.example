# PostgreSQL Database connection string
# Replace with your Supabase / Neon / Local PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/habit_tracker?schema=public"
# Supabase pooler connections additionally need: ?sslmode=require&pgbouncer=true&connect_timeout=15

# Secret used to sign authentication JWT tokens
JWT_SECRET="super-secret-habit-tracker-jwt-key-change-in-production"
